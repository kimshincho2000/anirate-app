<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 1. Main Web View Container -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Top Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:progressDrawable="@drawable/progress_drawable"
        android:visibility="gone" />

    <!-- Floating Quick Access to Saved Downloads (iOS Glassmorphism Style) -->
    <LinearLayout
        android:id="@+id/btn_quick_downloads_fab"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_ios_glass_card"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Saqlanganlar"
            android:src="@drawable/ic_download" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Saqlanganlar"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Offline Mode Screen (iOS Glass Style) -->
    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_ios_glass_pill"
            android:padding="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Oflayn"
                android:src="@drawable/ic_video_clip" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Oflayn Rejim"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Internet mavjud emas. Yuklab olingan animelaringizni internetsiz tomosha qilishingiz mumkin."
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <!-- Button: Open In-App Saved Animes -->
        <LinearLayout
            android:id="@+id/btn_open_downloads"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_ios_primary_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Download"
                android:src="@drawable/ic_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Saqlangan animelarni ko'rish"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Button: Retry Connection -->
        <LinearLayout
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ios_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Retry"
                android:src="@drawable/ic_refresh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Qayta ulanish"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. In-App Downloaded Anime List View (iOS Style) -->
    <LinearLayout
        android:id="@+id/layout_downloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#D9111420"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/btn_close_downloads"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_ios_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Orqaga"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="Orqaga"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Saqlangan Animelar"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btn_admin_toggle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_ios_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Admin"
                    android:src="@drawable/ic_lock" />

                <TextView
                    android:id="@+id/tv_admin_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Admin"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty state text if no downloads -->
        <TextView
            android:id="@+id/tv_empty_downloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:padding="20dp"
            android:text="Hozircha saqlangan animelar yo'q.\nSaytda animeni ochib «Yuklab olish» tugmasini bossangiz, bu yerda saqlanadi."
            android:textColor="#6B7280"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- List of downloaded videos -->
        <ListView
            android:id="@+id/list_downloads"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp" />
    </LinearLayout>

    <!-- 4. Built-in 1:1 iOS Glassmorphism Video Player -->
    <FrameLayout
        android:id="@+id/layout_internal_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- Video Surface -->
        <VideoView
            android:id="@+id/internal_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Gesture Surface -->
        <View
            android:id="@+id/player_touch_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- Center Glowing Red Play/Pause Crystal Button -->
        <FrameLayout
            android:id="@+id/player_center_play_btn"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_player_center_play"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:visibility="visible">

            <ImageView
                android:id="@+id/iv_center_play_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Play/Pause"
                android:src="@drawable/ic_play" />
        </FrameLayout>

        <!-- Left Seek Ripple (-10s) -->
        <LinearLayout
            android:id="@+id/ripple_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_player_ripple_badge"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Rewind"
                android:src="@drawable/ic_rewind_10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="-10s"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Seek Ripple (+10s) -->
        <LinearLayout
            android:id="@+id/ripple_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_player_ripple_badge"
            android:elevation="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="+10s"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Forward"
                android:src="@drawable/ic_forward_10" />
        </LinearLayout>

        <!-- Controls Overlay -->
        <FrameLayout
            android:id="@+id/player_controls_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Header Glass Bar -->
            <LinearLayout
                android:id="@+id/player_top_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                android:background="#D90E121C"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/btn_exit_player"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ios_glass_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Orqaga"
                        android:src="@drawable/ic_chevron_left" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="Orqaga"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_player_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Anime Video"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Speed Button (iOS Pill Style) -->
                <LinearLayout
                    android:id="@+id/btn_player_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ios_glass_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Speed"
                        android:src="@drawable/ic_speed" />

                    <TextView
                        android:id="@+id/tv_player_speed_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="1.0x"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Floating Glass Island Bar (1:1 with site & iOS) -->
            <LinearLayout
                android:id="@+id/player_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:layout_margin="14dp"
                android:background="@drawable/bg_player_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <!-- Play/Pause Button -->
                <FrameLayout
                    android:id="@+id/btn_player_play"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iv_bottom_play_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Play"
                        android:src="@drawable/ic_play" />
                </FrameLayout>

                <!-- Rewind 10s -->
                <FrameLayout
                    android:id="@+id/btn_player_rewind"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_ios_glass_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="7dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Rewind"
                        android:src="@drawable/ic_rewind_10" />
                </FrameLayout>

                <!-- Forward 10s -->
                <FrameLayout
                    android:id="@+id/btn_player_forward"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_ios_glass_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="7dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_forward_10" />
                </FrameLayout>

                <!-- Current Time -->
                <TextView
                    android:id="@+id/tv_player_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- AniRate Red SeekBar -->
                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/player_seekbar_progress"
                    android:thumb="@drawable/player_seekbar_thumb" />

                <!-- Total Duration -->
                <TextView
                    android:id="@+id/tv_player_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="00:00"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <!-- Fullscreen Button -->
                <FrameLayout
                    android:id="@+id/btn_player_fullscreen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Fullscreen"
                        android:src="@drawable/ic_fullscreen" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- 5. Fullscreen container for Web HTML5 videos -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
